# ═══════════════════════════════════════════════════════════
# 外汇网格交易总控台 · 配置模板（fx-grid-bot）
# 5 个品种槽位，默认全部 paper（模拟盘，不发送真实订单）。
# 所有槽位共享同一个 MT5 终端（单终端登入）。
# ═══════════════════════════════════════════════════════════

# 安全默认值：只允许本机访问。不要在没有反向代理鉴权时改为 0.0.0.0。
HOST=127.0.0.1
PORT=8283

# 模拟账户初始余额（paper 模式共用，币种以账户为准）
PAPER_BALANCE=10000

# ── MT5 通道（单终端登入） ────────────────────────────────────────
# MT5 终端路径（terminal64.exe）
MT5_TERMINAL=F:\MT5\terminal64.exe
# 登录凭据（不填则用终端已登录的账户）
MT5_LOGIN=61564223
MT5_PASSWORD=
MT5_SERVER=Pepperstone-Demo
# Python 解释器（默认用系统 python；也可指定 venv 路径）
MT5_PYTHON=
# 行情轮询间隔（毫秒，驱动模拟撮合与网格价格）
MT5_POLL_MS=1000
# 桥接方式：python=MetaTrader5 库（依赖终端 IPC，多终端时会端口冲突）
#           ea=MQL5 桥 EA（WebRequest 走本地 HTTP，绕开 IPC 端口冲突，推荐多终端环境）
# EA 桥模式部署见 docs/MT5桥EA部署指南.md
MT5_BRIDGE=python
EA_BRIDGE_PORT=8383
# 终端初始化失败重试（终端被回测占用时自动退避重试）
MT5_RETRY_BASE_MS=5000
MT5_RETRY_MAX_MS=30000

# ── 5 品种槽位 ───────────────────────────────────────────────────
# 每个槽位：SYMBOL（品种）/ MODE（paper|live）/ PLATFORM（接入平台）
# platform 是预留接入位：当前只有 mt5；未来实现 oanda/fxcm/icmarkets
# 适配器后在 src/exchange/platforms/ 注册并改这里即可（见 docs/接入新平台.md）。

# Slot 1 · EURUSD
EUR_SYMBOL=EURUSD
EUR_MODE=paper
EUR_PLATFORM=mt5

# Slot 2 · GBPUSD
GBP_SYMBOL=GBPUSD
GBP_MODE=paper
GBP_PLATFORM=mt5

# Slot 3 · USDJPY
JPY_SYMBOL=USDJPY
JPY_MODE=paper
JPY_PLATFORM=mt5

# Slot 4 · XAUUSD
XAU_SYMBOL=XAUUSD
XAU_MODE=paper
XAU_PLATFORM=mt5

# Slot 5 · NAS100
NAS_SYMBOL=NAS100
NAS_MODE=paper
NAS_PLATFORM=mt5

# ── 代理 / IP 配置 ────────────────────────────────────────────────
# 全局代理（优先级最高）。支持 http(s):// 与 socks5://（含认证）
GLOBAL_PROXY=
# 各槽位独立代理（仅在 GLOBAL_PROXY 未设置时生效）
EUR_PROXY=
GBP_PROXY=
JPY_PROXY=
XAU_PROXY=
NAS_PROXY=

# ── AI 助手（可选：风控哨兵/日报/市况分析/对话操控/出区间建议）──
# 协议类型：openai | anthropic | gemini（openai=所有 OpenAI 兼容服务）
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_MODEL_SMALL=
AI_SENTINEL_MINUTES=5
AI_MARKET_MINUTES=30
AI_REPORT_HOUR=20

# 通知推送（可选）：Telegram + 通用 Webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK=

# ── 风控熔断（可选，0=关闭） ──────────────────────────────────────────────
# 回撤熔断：品种总盈亏（已实现+未实现）相对启动权益跌幅超过该百分比 → 自动停止该品种
# （停止方式跟随各品种 outOfRangeAction：平仓 或 保留持仓）。建议 5-15。
MAX_DRAWDOWN_PCT=0
# 日亏损限额：账户当日亏损（相对当天基准权益）超过该百分比 → 自动停止。跨天自动重置。建议 3-8。
DAILY_LOSS_LIMIT_PCT=0
